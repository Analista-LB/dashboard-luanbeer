# ==============================================================================
# Variables de Entorno — Dashboard LuanBeer
# Copiar este archivo a .env y completar con las credenciales oficiales de Supabase
# NUNCA subir .env al repositorio ni exponer SUPABASE_SERVICE_ROLE_KEY en el cliente
# ==============================================================================

# URL de la instancia de Supabase (Pública)
SUPABASE_URL=https://your-project-id.supabase.co

# Clave Anónima / Pública de Supabase (Segura para Frontend con RLS activo)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave Service Role (ESTRICTAMENTE PRIVADA - Solo para scripts backend / CI/CD)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# Cloudflare Pages — Headers de Seguridad y Control de Caché
# ==============================================================================

# Caché agresivo para librerías vendor estáticas (inmutables)
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Caché para assets estáticos (imágenes, logos)
/src/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

# Hojas de estilo y scripts de módulos: revalidación segura
/src/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=600
  X-Content-Type-Options: nosniff

# HTML principal de la SPA: siempre fresco (no-cache para asegurar ver la última versión)
/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
